[Unit]
Description=mjagent - customer agent app demo (PingOne / WeCom -> Scutum -> Lyra A2A)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mjagent
WorkingDirectory=/opt/mjagent
EnvironmentFile=/opt/mjagent/.env
# 单进程多线程：会话存在进程内（见 src/mjagent/store.py）；SSE 长连接需要线程 worker 与较长超时
ExecStart=/opt/mjagent/.venv/bin/gunicorn --workers 1 --threads 32 --worker-class gthread \
    --bind 127.0.0.1:5000 --timeout 330 --access-logfile - mjagent.app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
