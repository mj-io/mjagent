# ---- 本应用 ----
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# 本应用对外地址（OAuth 回调由它拼出：/auth/pingone/callback、/auth/wecom/callback）
APP_BASE_URL=http://localhost:5000
# /debug 页（展示各段 token 的 claims，仅联调用）
DEBUG_PAGE=true

# ---- PingOne（客户自己的 IdP）----
# issuer = 应用 Overview → Connection Details 的 Issuer ID（区域要对，如 .sg）
PINGONE_ISSUER=https://auth.pingone.com/<env-id>/as
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=
# 必须带上 Scutum custom resource 的 scope（a2a.invoke），PingOne 才会签出 aud=Scutum 的 access_token
PINGONE_SCOPES=openid profile email a2a.invoke
# 交给 Scutum 的 subject token：access_token（推荐，方案 A）| id_token（方案 A-lite，Scutum 侧需管理员开启）
PINGONE_SUBJECT_TOKEN=access_token
# 两段交换（PingFederate 等）：登录不带 a2a.invoke（PINGONE_SCOPES=openid profile email），
# 调 A2A 前用登录 access_token 在 IdP 的交换专用 client 上换一张签给 Scutum 的 token。不配则不启用。
PINGONE_EXCHANGE_CLIENT_ID=
PINGONE_EXCHANGE_CLIENT_SECRET=
PINGONE_EXCHANGE_SCOPE=a2a.invoke

# ---- Microsoft Entra ID 登录 + OBO（见 entra.py）----
# 本应用在 Entra 的应用注册：回调 {APP_BASE_URL}/auth/entra/callback，公开 API api://<client id>/access_as_user
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# secret 放单独文件（600），也可直接配 ENTRA_CLIENT_SECRET
ENTRA_CLIENT_SECRET_FILE=/opt/mjagent/.entra_client_secret
# 登录 scope，缺省为 openid profile email offline_access api://<ENTRA_CLIENT_ID>/access_as_user
ENTRA_SCOPES=
# OBO 目标：Scutum 在客户 Entra 注册的 API 应用的 scope（该应用清单设 requestedAccessTokenVersion=2）
ENTRA_OBO_SCOPE=api://<Scutum API 应用 client id>/a2a.invoke
# Scutum 上身份源为 Entra 的集成应用（idp_token）
SCUTUM_ENTRA_CLIENT_ID=
SCUTUM_ENTRA_CLIENT_SECRET_FILE=/opt/mjagent/.scutum_entra_client_secret

# ---- 本地账号登录（本应用自己的账号体系）----
# 账号文件（600），用 python -m mjagent.local_users add <账号> --crm-subject <CRM username> 添加
LOCAL_USERS_FILE=/opt/mjagent/keys/local-users.json

# ---- 兜底模式（Scutum subject_field）：本地账号用本应用私钥签用户断言换 Lyra token ----
# 公钥（JWKS，带 kid）登记在 Scutum 的这个 client 上；断言 sub = 账号的 crm_subject。PingOne / PF 登录仍走 Token Exchange
SCUTUM_ASSERTION_CLIENT_ID=
SCUTUM_ASSERTION_KEY_FILE=/opt/mjagent/keys/scutum-assertion.pem
SCUTUM_ASSERTION_KID=
SCUTUM_ASSERTION_ALG=RS256

# ---- 企业微信（客户自己的企微自建应用；secret 配在 Scutum，本应用不需要）----
WECOM_CORP_ID=
WECOM_AGENT_ID=

# ---- Scutum（CRM 认证中心）：每种交换方式一个集成方 client（POST /admin/clients 预注册拿到）----
SCUTUM_ISSUER=https://scutum-auth-login.crmdev.veevasfa.com
SCUTUM_PINGONE_CLIENT_ID=
SCUTUM_PINGONE_CLIENT_SECRET=
SCUTUM_WECOM_CLIENT_ID=
SCUTUM_WECOM_CLIENT_SECRET=

# ---- Lyra A2A ----
LYRA_BASE_URL=https://wchat-auth-login.crmdev.veevasfa.com/lyra
# RFC 8707 resource（Scutum token 的 aud），与 Scutum SCUTUM_OAUTH_RESOURCES / Lyra A2A_AUTH_RESOURCE_URL 一致
LYRA_RESOURCE=https://wchat-auth-login.crmdev.veevasfa.com/lyra/a2a
HTTP_VERIFY_TLS=true
